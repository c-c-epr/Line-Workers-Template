{
  "name": "line-workers-template",
  "version": "0.0.0",
  "private": false,
  "scripts": {
    "types": "wrangler types",
    "types:sync": "wrangler types",
    "types:check": "npm run types:sync && git diff --exit-code -- worker-configuration.d.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "start": "wrangler dev --env--file .env",
    "dev": "wrangler dev --env--file .env",
    "deploy": "wrangler deploy --secrets-file .env",
    "prestart": "npm run types:sync",
    "predev": "npm run types:sync",
    "predeploy": "npm run types:sync"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.98.0"
  },
  "dependencies": {
    "@line/bot-sdk": "^11.0.1"
  },
  "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f"
}
